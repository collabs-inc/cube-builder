{
  "name": "cube-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run test:node && npm run test:web",
    "typecheck": "tsc --noEmit",
    "test:node": "node --import tsx --test --test-timeout=30000 test/server/*.test.ts test/worker/*.test.ts",
    "test:web": "vitest run",
    "test:browser": "node --import tsx test/browser/run.ts",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.47.0",
    "@blocknote/mantine": "0.47.0",
    "@blocknote/react": "0.47.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@phosphor-icons/react": "2.1.7",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-typography": "^3.31.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "katex": "^0.19.0",
    "monaco-editor": "0.55.1",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "smol-toml": "^1.9.0",
    "ws": "8.21.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "^0.28.2",
    "happy-dom": "20.14.5",
    "playwright": "^1.63.0",
    "tailwindcss": "4.2.0",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "uuid": "11.1.1",
    "katex": "$katex",
    "esbuild": "$esbuild"
  }
}
